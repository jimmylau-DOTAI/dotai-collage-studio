<!doctype html>
<html lang="zh-Hant"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>DotAI · 拼圖排版編輯器</title>
<style>
:root{--ink:#202124;--muted:#697078;--line:#e0e3e7;--accent:#2563eb}*{box-sizing:border-box}[hidden]{display:none!important}body{margin:0;background:#f6f7f8;color:var(--ink);font:14px/1.5 -apple-system,BlinkMacSystemFont,"PingFang TC",sans-serif}button,input,select{font:inherit}button{cursor:pointer;color:inherit}button:disabled,input:disabled,select:disabled{opacity:.45;cursor:not-allowed}button:focus-visible,input:focus-visible,select:focus-visible,canvas:focus-visible{outline:3px solid #93b4ff;outline-offset:2px}
header{padding:18px 26px;display:flex;justify-content:space-between;align-items:center;background:white;border-bottom:1px solid var(--line);gap:12px}h1{font-size:21px;margin:0}header p{font-size:12px;color:var(--muted);margin:3px 0 0}h2{font-size:14px;margin:0 0 8px}.primary{background:#202124;color:white;border:0;border-radius:8px;padding:11px 18px;font-weight:600;white-space:nowrap}.secondary{background:white;border:1px solid var(--line);border-radius:7px;padding:8px 10px}.secondary:hover,.layout:hover{background:#f0f2f5}.full{width:100%}
main{max-width:1420px;margin:auto;padding:22px;display:grid;grid-template-columns:230px minmax(300px,1fr) 290px;gap:22px}.panel{background:white;border:1px solid var(--line);border-radius:12px;padding:17px;align-self:start;min-width:0}.hint,.small-note{font-size:12px;color:var(--muted);margin:6px 0 14px}.small-note{font-size:11px}.divider{height:1px;background:var(--line);margin:18px 0}.layouts{display:grid;grid-template-columns:1fr 1fr;gap:8px}.layout{border:1px solid var(--line);border-radius:7px;background:white;padding:9px 3px;display:flex;flex-direction:column;align-items:center;font-size:11px;gap:5px}.layout svg{width:32px;height:40px;color:#a1a7af}.layout[aria-pressed=true],.photo[aria-pressed=true]{border-color:var(--accent);background:#f3f7ff}.range-label{display:flex;justify-content:space-between;font-size:12px;margin:12px 0 3px}input[type=range]{width:100%;accent-color:var(--accent)}output{color:var(--muted);font-variant-numeric:tabular-nums}.swatches{display:flex;gap:9px;margin-top:10px}.swatch{width:25px;height:25px;border:1px solid #bbb;border-radius:50%;background:var(--swatch)}.swatch[aria-pressed=true]{outline:2px solid var(--accent);outline-offset:3px}.color-wrap{position:relative;width:26px;height:26px;overflow:hidden;border-radius:50%;border:1px solid #bbb}.color-wrap input{position:absolute;left:-8px;top:-8px;width:42px;height:42px}
.stage{position:sticky;top:18px;align-self:start;min-width:0;display:flex;align-items:center;flex-direction:column}.stage-top{width:100%;max-width:550px;display:flex;justify-content:space-between;font-size:12px;color:var(--muted);margin-bottom:9px}.canvas-wrap{position:relative;width:min(100%,calc((100vh - 250px)*.8));min-width:260px;max-width:550px;aspect-ratio:4/5;background:white;box-shadow:0 8px 34px #0000000d;overflow:hidden}canvas{display:block;width:100%;height:100%;touch-action:none;cursor:grab}canvas.dragging{cursor:grabbing}#edit-overlay,.initial-preview{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}.initial-preview{object-fit:cover}.selection{position:absolute;pointer-events:none;border:2px solid #2563eb;display:none}.selection.on{display:block}.selection span{position:absolute;left:4px;top:4px;font-size:10px;background:white;color:#202124;padding:2px 5px;border-radius:3px}.mode-row{width:100%;max-width:550px;display:flex;align-items:center;gap:10px;margin-bottom:10px}.mode-row select{flex:1;border:1px solid var(--line);background:white;padding:8px;border-radius:7px}.stage-caption{font-size:12px;color:var(--muted);text-align:center;margin:12px 0 6px}.toolbar{display:flex;gap:7px;margin:10px 0}.toolbar button{font-size:12px}.preview-toggle{border:0;background:none;text-decoration:underline;color:var(--muted);font-size:12px}.toast{text-align:center;color:#475569;font-size:12px;min-height:22px;max-width:500px}.error{color:#b42318}
.photo-list{display:grid;grid-template-columns:1fr 1fr;gap:6px}.photo{min-width:0;border:1px solid var(--line);background:white;border-radius:7px;padding:6px;display:flex;align-items:center;gap:6px;text-align:left}.photo img{width:40px;height:36px;object-fit:cover;pointer-events:none}.photo .meta{font-size:11px;min-width:0}.photo small{display:none}.grip{color:#999}.photo.over{outline:2px dashed var(--accent)}.position-actions{display:flex;gap:6px;margin:9px 0}.position-actions button{flex:1;font-size:11px}.replace-label{display:block;text-align:center;border:1px dashed #bbb;padding:8px;border-radius:7px;font-size:12px;cursor:pointer}.file-input{position:absolute;opacity:0;width:1px;height:1px}.shapes{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}.shapes button{font-size:12px;padding:8px 3px}.numbers{display:grid;grid-template-columns:1fr 1fr;gap:7px}.numbers label{font-size:11px;color:var(--muted)}.numbers input{width:100%;padding:7px;border:1px solid var(--line);border-radius:6px;color:var(--ink);margin-top:3px}select#vertex{width:100%;padding:7px;border:1px solid var(--line);border-radius:6px;background:white}details{margin-top:12px}summary{cursor:pointer;font-size:12px;font-weight:600}.export-note{font-size:11px;color:var(--muted);text-align:center}.download-fallback{display:block;color:var(--accent);font-size:12px;margin-top:8px}
@media(max-width:1100px){main{grid-template-columns:minmax(280px,1fr) 280px}.left{grid-column:1/-1;order:3;width:100%}.stage{order:1}.right{order:2}.layouts{grid-template-columns:repeat(5,1fr)}}
@media(max-width:680px){header{padding:14px}h1{font-size:17px}.primary{font-size:12px;padding:10px}main{display:flex;flex-direction:column;padding:12px;gap:14px}.stage{position:static;width:100%;order:0}.right,.left{width:100%}.canvas-wrap{width:100%;max-width:420px;min-width:0}.mode-row,.stage-top{max-width:420px}.layouts{grid-template-columns:repeat(5,1fr)}.layout{font-size:10px}}
</style><style>.canvas-wrap{--ratio:1;aspect-ratio:1;width:min(100%,calc((100vh - 290px)*var(--ratio)));max-width:650px}.layouts{grid-template-columns:repeat(3,1fr);max-height:510px;overflow:auto;padding:3px}.layout{font-size:10px}.layout svg{width:37px;height:37px}.ratio-row{display:flex;gap:10px;align-items:center;margin:0 0 14px}.ratio-row select{flex:1;padding:8px;border:1px solid var(--line);border-radius:7px;background:white}.cut-note{font-size:11px;color:var(--muted)}@media(max-width:1100px){.layouts{grid-template-columns:repeat(6,1fr)}}@media(max-width:680px){.layouts{grid-template-columns:repeat(4,1fr)}.canvas-wrap{width:100%;max-width:550px}}</style>
<style>
:root{--accent:#0059FF}body{background:#F5F8FF}.primary{background:var(--accent)}.primary:hover{filter:brightness(.92)}.layout[aria-pressed=true] svg{color:var(--accent)}
.swatches{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:10px 0}.swatch{width:auto;height:auto;min-height:46px;padding:9px 7px;display:flex;align-items:center;gap:7px;border:1px solid var(--line);border-radius:8px;background:white;text-align:left;font-size:11px;font-weight:600}.swatch::before{content:'';width:22px;height:22px;flex:none;background:var(--swatch);border:1px solid #00000016;border-radius:5px}.swatch[aria-pressed=true]{outline:2px solid var(--accent);outline-offset:0;background:#F5F8FF}.color-wrap{grid-column:1/-1;position:static;width:auto;height:auto;overflow:visible;display:flex;justify-content:space-between;align-items:center;border:1px solid var(--line);border-radius:8px;padding:6px 10px;font-size:12px}.color-wrap input{position:static;width:45px;height:30px;padding:2px;cursor:pointer;border:1px solid var(--line);border-radius:5px;background:white}
</style></head><body>
<header><div><h1>拼圖排版編輯器</h1><p>DotAI 配色・自由拼圖・可調斜切</p></div><button id="export-top" class="primary" disabled>下載 JPG ↗</button></header>
<main>
<aside class="panel left"><h2>DotAI 背景配色</h2><p class="hint">預設 IG 品牌藍。按一下即換色，原相保持不變。</p><div id="swatches" class="swatches" role="group" aria-label="DotAI 背景配色"></div><p class="small-note">品牌藍有辨識度；純白最簡潔；淺藍柔和；深藍沉穩。顏色會套用到外框及相片間距。</p><div class="divider"></div><label class="ratio-row" for="ratio">比例<select id="ratio"><option value="1:1">1:1 正方形</option><option value="4:3">4:3 橫向</option></select></label><h2>29 款排版</h2><p class="hint">四張相、不同組合。每款都可以自由調整。</p><div id="layouts" class="layouts"></div><p class="small-note">切換版式會重設自訂相框及形狀，可以復原。</p><div class="divider"></div><h2>留白</h2>
<label class="range-label" for="margin">外框 <output id="margin-value">18 px</output></label><input id="margin" type="range" min="0" max="64" value="18">
<label class="range-label" for="gap">間距 <output id="gap-value">12 px</output></label><input id="gap" type="range" min="0" max="48" value="12">
<label class="range-label" for="radius">方框圓角 <output id="radius-value">0 px</output></label><input id="radius" type="range" min="0" max="64" value="0"><p class="small-note">留白控制仍跟版式嘅相框；手動移位後，用右邊位置／大小調整。</p>
</aside>
<section class="stage" aria-label="即時拼圖預覽"><div class="stage-top"><span id="layout-name">經典四格</span><span id="size-label">1:1 · 1080 × 1080</span></div>
<label class="mode-row" for="edit-mode">操作模式<select id="edit-mode"><option value="crop">① 拖相片：調整相片構圖</option><option value="frame">② 移相框：移位／拉右下角改大小</option><option value="cut">③ 斜切分界：拖四個端點</option><option value="shape">④ 自訂單張斜切形狀：拉頂點</option></select></label>
<div id="canvas-wrap" class="canvas-wrap"><canvas id="canvas" width="1080" height="1080" tabindex="0" aria-label="相片畫布。模式包括拖相片、移相框、斜切分界、自訂形狀。方向鍵可微調。"></canvas><img id="initial-preview" class="initial-preview" src="__PREVIEW_DATA__" alt="DotAI 配色四張示範圖拼圖"><div id="selection" class="selection"><span id="selection-label">相片 1</span></div><canvas id="edit-overlay" width="1080" height="1080" aria-hidden="true"></canvas></div>
<p class="stage-caption">揀模板 → 移相框／拉分界。編輯線唔會出現在 JPG。</p><button id="preview" class="preview-toggle" aria-pressed="false">隱藏選框，睇完整效果</button><div class="toolbar"><button id="undo" class="secondary" disabled>↶ 復原</button><button id="redo" class="secondary" disabled>↷ 重做</button><button id="reset" class="secondary">重設全部</button></div><div id="status" class="toast" role="status" aria-live="polite">互動程式尚未啟動；目前顯示靜態預覽。</div><noscript>需要 JavaScript 才能編輯。</noscript></section>
<aside class="panel right"><h2>揀一張相片</h2><div id="photos" class="photo-list"></div><div class="position-actions"><button id="move-prev" class="secondary">← 換前一張</button><button id="move-next" class="secondary">換後一張 →</button></div><label class="replace-label">＋ 換入相片<input id="files" class="file-input" type="file" accept="image/jpeg,image/png,image/webp" multiple></label><div class="divider"></div><h2 id="selected-title">調整相片 1</h2>
<div id="cut-controls" hidden><h2>共用斜切分界</h2><label class="range-label" for="cut-top">上端位置 <output id="cut-top-value">43%</output></label><input id="cut-top" type="range" min="15" max="85" value="43"><label class="range-label" for="cut-bottom">下端位置 <output id="cut-bottom-value">59%</output></label><input id="cut-bottom" type="range" min="15" max="85" value="59"><label class="range-label" for="cut-left">左端位置 <output id="cut-left-value">46%</output></label><input id="cut-left" type="range" min="15" max="85" value="46"><label class="range-label" for="cut-right">右端位置 <output id="cut-right-value">56%</output></label><input id="cut-right" type="range" min="15" max="85" value="56"><button id="cut-straight" class="secondary full">分界回正／重新連結</button><p class="cut-note">改共用分界會重新連結四格，重設手動相框位置及單張形狀；可復原。自由移位則用「移相框」。</p><div class="divider"></div></div>
<div class="shapes"><button id="shape-rect" class="secondary">四邊形</button><button id="shape-diagonal" class="secondary">單張斜切</button><button id="shape-circle" class="secondary">圓／橢圓</button></div><details><summary>其他形狀</summary><div class="shapes"><button id="shape-triangle" class="secondary">三角形</button><button id="shape-diamond" class="secondary">菱形</button><button id="shape-hexagon" class="secondary">六邊形</button></div></details>
<details><summary>單張形狀頂點精調</summary><label class="range-label" for="vertex">選擇頂點</label><select id="vertex" disabled></select>
<label class="range-label" for="point-x">頂點水平 <output id="point-x-value">50%</output></label><input id="point-x" type="range" min="0" max="100" value="50" disabled>
<label class="range-label" for="point-y">頂點垂直 <output id="point-y-value">50%</output></label><input id="point-y" type="range" min="0" max="100" value="50" disabled><button id="shape-reset" class="secondary full">還原此形狀</button></details>
<details><summary>相框位置／大小（px）</summary><div class="numbers"><label>水平 X<input id="frame-x" type="number" min="0" max="1000"></label><label>垂直 Y<input id="frame-y" type="number" min="0" max="1270"></label><label>寬度<input id="frame-w" type="number" min="80" max="1080"></label><label>高度<input id="frame-h" type="number" min="80" max="1350"></label></div><button id="frame-reset" class="secondary full">相框返回版式位置</button></details>
<details open><summary>相片構圖</summary><label class="range-label" for="zoom">縮放 <output id="zoom-value">100%</output></label><input id="zoom" type="range" min="100" max="300" value="100"><label class="range-label" for="pan-x">水平 <output id="pan-x-value">52%</output></label><input id="pan-x" type="range" min="0" max="100" value="52"><label class="range-label" for="pan-y">垂直 <output id="pan-y-value">53%</output></label><input id="pan-y" type="range" min="0" max="100" value="53"><button id="center" class="secondary full">相片置中／還原縮放</button></details>
<div class="divider"></div><button id="export-bottom" class="primary full" disabled>下載 JPG ↗</button><p class="export-note">1:1 或 4:3 · 無標題／Logo／編輯線<br>原相不變，相片只在本機處理<br>關閉前先下載；未儲存嘅編輯會消失</p><a id="download-fallback" class="download-fallback" hidden>按此儲存 JPG</a></aside>
</main>
<script id="photo-data" type="application/json">__PHOTO_DATA__</script>
<script>(function(){var s=document.getElementById('status');s.textContent='正在啟動編輯器…';window.addEventListener('error',function(e){s.textContent='啟動失敗：'+e.message;});window.addEventListener('unhandledrejection',function(e){s.textContent='啟動失敗：'+(e.reason&&e.reason.message||String(e.reason));});})();</script>
<script>__CORE_JS__</script><script>__APP_JS__</script>
</body></html>
